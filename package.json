{
  "name": "naruto-gesture-detection",
  "private": true,
  "description": "Browser-only gesture training and Naruto-inspired shadow-clone effect.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "bun run lint:code && bun run lint:a11y && bun run lint:unused",
    "lint:code": "oxlint --type-aware --deny-warnings src tests *.ts",
    "lint:a11y": "html-validate index.html trainer.html",
    "lint:unused": "knip",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@fontsource/source-sans-pro": "5.3.0",
    "@mediapipe/holistic": "0.5.1675471629",
    "@mediapipe/selfie_segmentation": "0.1.1675465747",
    "@tensorflow/tfjs": "4.22.0",
    "idb": "8.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.7",
    "html-validate": "11.18.0",
    "knip": "6.44.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
