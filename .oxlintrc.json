{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "fake-indexeddb/auto"]
      }
    ],
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [".agents/**", ".claude/**", ".planning/**", "dist/**", "coverage/**"]
}
